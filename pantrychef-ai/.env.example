# Copy this file to .env for local development. Never commit the real .env.
# In AWS (App Runner / Elastic Beanstalk / ECS), set these as environment
# variables / secrets in the service configuration instead of a file.

GOOGLE_API_KEY=your-google-ai-studio-key-here
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of origins allowed to call the API. Use your deployed
# HTTPS URL in production; "*" is fine only for local development.
ALLOWED_ORIGINS=*
